{
  "schema_version": 1,
  "application": {
    "id": "com.example.myapp",
    "name": "My Application"
  },
  "current_version": {
    "source": "command_line",
    "path": "",
    "json_key": "version"
  },
  "update_source": {
    "provider": "manifest",
    "manifest_url": "https://github.com/OWNER/REPOSITORY/releases/latest/download/update.json",
    "channel": "stable"
  },
  "download": {
    "mode": "auto",
    "default_threads": 4,
    "allowed_threads": [1, 4, 16],
    "fallback_to_single": true,
    "resume": true,
    "retry_count": 5,
    "timeout_seconds": 30,
    "stall_timeout_seconds": 60,
    "max_file_size_mb": 2048,
    "segment_storage": "separate_files",
    "min_segment_size_mb": 1,
    "verify_etag": true,
    "merge_after_download": true,
    "delete_parts_after_merge": true
  },
  "security": {
    "require_https": true,
    "require_sha256": true,
    "allowed_hosts": ["github.com", "objects.githubusercontent.com"]
  },
  "installer": {
    "wait_for_main_program": true,
    "request_admin": true,
    "arguments": [],
    "delete_after_install": false
  },
  "restart": {
    "enabled": false,
    "program_path": "",
    "arguments": []
  },
  "interface": {
    "language": "zh-CN",
    "show_progress": true,
    "confirm_before_download": true,
    "confirm_before_install": true
  },
  "logging": {
    "enabled": true,
    "retention_days": 14
  }
}
